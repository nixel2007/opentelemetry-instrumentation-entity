КонецПроцедуры

// Служебные

Процедура ПодготовитьСдк(Знач ТрассировщикВключен)

	Экспортер = Новый ЭкспортерСпановВПамяти;
	Ресурс = Новый ОтелРесурс(Истина);
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс, Новый ОтелПростойПроцессорСпанов(Экспортер));
	Область = Новый ОтелОбластьИнструментирования("entity", "test");
	Трассировщик = Новый ОтелТрассировщик(Область, ПровайдерТрассировки, Новый ОтелКонфигурацияТрассировщика(ТрассировщикВключен));

	ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс);
	Метр = ПровайдерМетрик.ПостроительМетра("entity").Построить();

КонецПроцедуры

Процедура СоздатьМенеджерInMemory(Знач Настройки = Неопределено)
	СоздатьМенеджер(Тип("КоннекторInMemory"), Строка(Новый УникальныйИдентификатор), Настройки);
КонецПроцедуры

Процедура СоздатьМенеджерSQLite(Знач Настройки = Неопределено)
	ФайлБазы = ПолучитьИмяВременногоФайла("sqlite");
	СоздатьМенеджер(Тип("КоннекторSQLite"), "Data Source=" + ФайлБазы, Настройки);
КонецПроцедуры

Процедура СоздатьМенеджер(Знач ТипКоннектора, Знач СтрокаСоединения, Знач Настройки)

	МенеджерСущностей = Новый МенеджерСущностей(ТипКоннектора, СтрокаСоединения);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СтранаМира"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("ФизическоеЛицо"));
	МенеджерСущностей.ДобавитьНаблюдателя(Новый ОтелНаблюдательИсточникаДанных(Трассировщик, Метр, Настройки));
	МенеджерСущностей.Инициализировать();

КонецПроцедуры

Функция НовоеФизическоеЛицо(Знач Имя)
	Лицо = Новый ФизическоеЛицо;
	Лицо.Имя = Имя;
	Возврат Лицо;
КонецФункции

Функция ЕдинственныйСпан(Знач Имя)
	Спаны = Экспортер.ПоИмени(Имя);
	Ожидаем.Что(Спаны, "Ожидался один спан " + Имя + ", экспортированы: " + ИменаСпанов()).ИмеетДлину(1);
	Возврат Спаны[0];
КонецФункции

Функция ИменаСпанов()
	Имена = Новый Массив;
	Для Каждого Спан Из Экспортер.Спаны Цикл
		Имена.Добавить(Спан.Имя());
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

Функция ИдСпана(Знач Спан)
	Возврат Спан.КонтекстСпана().ИдСпана();
КонецФункции

Функция ДанныеМетрики(Знач Имя)
	Для Каждого Инструмент Из Метр.Инструменты() Цикл
		Если Инструмент.Имя() = Имя Тогда
			Возврат Инструмент.Собрать(Метр.Ресурс(), Метр.ОбластьИнструментирования(), Инструмент.Имя(), Инструмент.Описание());
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Метрика не найдена: " + Имя;
КонецФункции

Функция ТочкиМетрики(Знач Имя)
	Возврат ДанныеМетрики(Имя).ТочкиДанных();
КонецФункции

Функция ЕдинственнаяТочка(Знач Имя)
	Точки = ТочкиМетрики(Имя);
	Ожидаем.Что(Точки, "Ожидалась одна точка данных " + Имя).ИмеетДлину(1);
	Возврат Точки[0];
КонецФункции

Функция ТочкаМетрики(Знач Имя, Знач КлючАтрибута, Знач ЗначениеАтрибута)
	Для Каждого Точка Из ТочкиМетрики(Имя) Цикл
		Если Атрибут(Точка, КлючАтрибута) = ЗначениеАтрибута Тогда
			Возврат Точка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Точка %1 с %2 = %3 не найдена", Имя, КлючАтрибута, ЗначениеАтрибута);
КонецФункции

// Атрибуты точки данных лежат в формате OTLP: массив пар key и value, где value - соответствие
// с единственным типизированным полем (stringValue, intValue, doubleValue, boolValue).
Функция Атрибут(Знач Точка, Знач Ключ)
	Для Каждого Пара Из Точка.Получить("attributes") Цикл
		Если Пара.Получить("key") = Ключ Тогда
			Для Каждого Типизированное Из Пара.Получить("value") Цикл
				Возврат Типизированное.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПараметрыВызова(Знач Первый, Знач Второй)
	Параметры = Новый Массив;
	Параметры.Добавить(Первый);
	Параметры.Добавить(Второй);
	Возврат Параметры;
КонецФункции
