	Ожидаем.Что(Спан.Атрибуты().Получить("db.system.name")).Равно("inmemory");
	Ожидаем.Что(Спан.Атрибуты().Получить("db.query.text")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТекстЗапросаОтключаетсяНастройкой() Экспорт

