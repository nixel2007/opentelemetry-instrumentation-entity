// ОтелНаблюдательИсточникаДанных: спаны и метрики по событиям источника данных entity.
//
// Настоящий МенеджерСущностей с КоннекторInMemory (и КоннекторSQLite там, где нужен текст
// запроса), SDK на провайдерах в памяти: спаны собирает ЭкспортерСпановВПамяти, метрики
// читаются прямо с инструментов метра.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "."
#Использовать entity
#Использовать opentelemetry
#Использовать asserts

// ЭкспортерСпановВПамяти - Получает завершенные спаны.
Перем Экспортер;
// ОтелТрассировщик - Трассировщик наблюдателя.
Перем Трассировщик;
// ОтелМетр - Метр наблюдателя.
Перем Метр;
// ПроцессорЛоговВПамяти - Получает записи логов наблюдателя.
Перем ПроцессорЛогов;
// ОтелЛоггер - Логгер наблюдателя.
Перем Логгер;
// МенеджерСущностей - Менеджер, за которым наблюдают.
Перем МенеджерСущностей;
// Строка - Путь к файлу базы SQLite, если тест ее создавал.
Перем ФайлБазы;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ОтелКонтекст.Очистить();
	ПодготовитьСдк(Истина);
	МенеджерСущностей = Неопределено;
	ФайлБазы = Неопределено;

КонецПроцедуры

&ПослеКаждого
Процедура ПослеЗапускаТеста() Экспорт

	Если МенеджерСущностей <> Неопределено Тогда
		МенеджерСущностей.Закрыть();
	КонецЕсли;
	Если ФайлБазы <> Неопределено Тогда
		УдалитьФайлы(ФайлБазы);
	КонецЕсли;
	ОтелКонтекст.Очистить();
	ОтелУтилиты.СброситьКлассификаторНативныхОшибок();

КонецПроцедуры

// Спаны операций

&Тест
Процедура ОперацияДаетВнутреннийСпанСАтрибутамиСущности() Экспорт

	СоздатьМенеджерInMemory();

	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));

	Спан = ЕдинственныйСпан("Сохранить ФизическоеЛицо");
	Ожидаем.Что(Спан.ВидСпана()).Равно(ОтелВидСпана.Внутренний());
	Ожидаем.Что(Спан.Атрибуты().Получить("code.namespace")).Равно("МенеджерСущностей");
	Ожидаем.Что(Спан.Атрибуты().Получить("code.function.name")).Равно("Сохранить");
	Ожидаем.Что(Спан.Атрибуты().Получить("entity.type")).Равно("ФизическоеЛицо");
	Ожидаем.Что(Спан.Атрибуты().Получить("entity.table")).Равно("ФизическиеЛица");
	Ожидаем.Что(Спан.КодСтатуса()).Равно(ОтелКодСтатуса.НеУстановлен());
	Ожидаем.Что(Спан.Завершен()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧтениеДобавляетКоличествоСтрокВСпан() Экспорт

	СоздатьМенеджерInMemory();
	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));
	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Гоголь"));
	Экспортер.Очистить();

	МенеджерСущностей.Получить(Тип("ФизическоеЛицо"));

	Спан = ЕдинственныйСпан("Получить ФизическоеЛицо");
	Ожидаем.Что(Спан.Атрибуты().Получить("entity.result.count")).Равно(2);

КонецПроцедуры

&Тест
Процедура ВложеннаяОперацияИЗапросыСтановятсяДочернимиСпанами() Экспорт

	СоздатьМенеджерInMemory();
	Страна = Новый СтранаМира;
	Страна.Код = "RU";
	Страна.Наименование = "Россия";
	МенеджерСущностей.Сохранить(Страна);
	Лицо = НовоеФизическоеЛицо("Пушкин");
	Лицо.Страна = Страна;
	МенеджерСущностей.Сохранить(Лицо);
	Экспортер.Очистить();

	МенеджерСущностей.Получить(Тип("ФизическоеЛицо"));

	Родитель = ЕдинственныйСпан("Получить ФизическоеЛицо");
	Вложенный = ЕдинственныйСпан("ПолучитьОдно СтранаМира");
	Запросы = Экспортер.ПоИмени("SELECT ФизическиеЛица");

	Ожидаем.Что(Родитель.ИдРодительскогоСпана(), "Операция из прикладного кода - корень").Равно("");
	Ожидаем.Что(Вложенный.ИдРодительскогоСпана(), "Разыменование ссылки вложено в чтение").Равно(ИдСпана(Родитель));
	Ожидаем.Что(Вложенный.Атрибуты().Получить("entity.depth")).Равно(1);
	Ожидаем.Что(Запросы).ИмеетДлину(1);
	Ожидаем.Что(Запросы[0].ИдРодительскогоСпана(), "Запрос вложен в свою операцию").Равно(ИдСпана(Родитель));
	Ожидаем.Что(ОтелКонтекст.ТекущийСпан(), "Область спана закрыта после операции").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОшибкаОперацииПопадаетВСпанИМетрику() Экспорт

	СоздатьМенеджерSQLite();
	Экспортер.Очистить();
	Контекст = Новый Структура("Текст", "SELECT * FROM НетТакойТаблицы");

	Ожидаем.Что(МенеджерСущностей)
		.Метод("ВыполнитьСКоннектором", ПараметрыВызова("Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)", Контекст))
		.ВыбрасываетИсключение("НетТакойТаблицы");

	// Ошибка SQLite классификатору ядра неизвестна: error.type - запасное значение _OTHER, а не путь к модулю
	Операция = ЕдинственныйСпан("ВыполнитьСКоннектором");
	Ожидаем.Что(Операция.КодСтатуса()).Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Операция.Атрибуты().Получить("error.type")).Равно("_OTHER");
	Ожидаем.Что(Операция.События(), "Исключение пишется логом, а не событием спана").ИмеетДлину(0);

	Запрос = ЕдинственныйСпан("SELECT");
	Ожидаем.Что(Запрос.КодСтатуса()).Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Запрос.Атрибуты().Получить("error.type")).Равно("_OTHER");
	Ожидаем.Что(Запрос.События(), "Исключение пишется логом, а не событием спана").ИмеетДлину(0);

	Точка = ТочкаМетрики("db.client.operation.duration", "db.operation.name", "SELECT");
	Ожидаем.Что(Атрибут(Точка, "error.type")).Равно("_OTHER");
	Ожидаем.Что(Точка.Получить("count")).Равно(1);

	ТочкаОперации = ТочкаМетрики("entity.operation.duration", "entity.operation", "ВыполнитьСКоннектором");
	Ожидаем.Что(Атрибут(ТочкаОперации, "error.type")).Равно("_OTHER");

КонецПроцедуры

&Тест
Процедура ТипОшибкиИзКлассификатораОдинРазНаСобытие() Экспорт

	// Дано - без логгера записей исключений нет, классифицирует ошибку только наблюдатель
	Логгер = Неопределено;
	Классификатор = КлассификаторОшибкиСУБД();
	СоздатьМенеджерSQLite();
	Экспортер.Очистить();

	// Когда
	ВыполнитьЗапросКНесуществующейТаблице();

	// Тогда - error.type спана и метрики одного события совпадают, классификация - одна на событие
	Запрос = ЕдинственныйСпан("SELECT");
	Ожидаем.Что(Запрос.Атрибуты().Получить("error.type")).Равно("db.table.not_found");
	Точка = ТочкаМетрики("db.client.operation.duration", "db.operation.name", "SELECT");
	Ожидаем.Что(Атрибут(Точка, "error.type")).Равно("db.table.not_found");
	Операция = ЕдинственныйСпан("ВыполнитьСКоннектором");
	Ожидаем.Что(Операция.Атрибуты().Получить("error.type")).Равно("db.table.not_found");
	ТочкаОперации = ТочкаМетрики("entity.operation.duration", "entity.operation", "ВыполнитьСКоннектором");
	Ожидаем.Что(Атрибут(ТочкаОперации, "error.type")).Равно("db.table.not_found");
	Ожидаем.Что(Классификатор.Вызовов, "Запрос и операция - по одной классификации").Равно(2);

КонецПроцедуры

&Тест
Процедура ТипИсключенияВЗаписиЗаполняетЯдро() Экспорт

	// Дано
	КлассификаторОшибкиСУБД();
	СоздатьМенеджерSQLite();

	// Когда
	ВыполнитьЗапросКНесуществующейТаблице();

	// Тогда - exception.type записи ядро берет из исключения, переданного в запись
	Запись = ПроцессорЛогов.ПоИмениСобытия("db.client.operation.exception")[0];
	Ожидаем.Что(Запись.Атрибуты().Получить("exception.type")).Равно("db.table.not_found");

КонецПроцедуры

&Тест
Процедура ИсключениеЗапросаИОперацииПишетсяЗаписьюЛога() Экспорт

	СоздатьМенеджерSQLite();
	Экспортер.Очистить();
	Контекст = Новый Структура("Текст", "SELECT * FROM НетТакойТаблицы");

	Ожидаем.Что(МенеджерСущностей)
		.Метод("ВыполнитьСКоннектором", ПараметрыВызова("Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)", Контекст))
		.ВыбрасываетИсключение("НетТакойТаблицы");

	// Запрос к СУБД - клиентская операция: событие операции с суффиксом .exception, WARN
	Запрос = ЕдинственныйСпан("SELECT");
	ЗаписиЗапроса = ПроцессорЛогов.ПоИмениСобытия("db.client.operation.exception");
	Ожидаем.Что(ЗаписиЗапроса).ИмеетДлину(1);
	ПроверитьЗаписьИсключения(ЗаписиЗапроса[0], Запрос);
	// Атрибуты запроса - чтобы найти запись и без трассы; текста запроса в записи нет
	АтрибутыЗаписиЗапроса = ЗаписиЗапроса[0].Атрибуты();
	Ожидаем.Что(АтрибутыЗаписиЗапроса.Получить("db.system.name")).Равно("sqlite");
	Ожидаем.Что(АтрибутыЗаписиЗапроса.Получить("db.operation.name")).Равно("SELECT");
	Ожидаем.Что(АтрибутыЗаписиЗапроса.Получить("db.namespace")).Равно(Запрос.Атрибуты().Получить("db.namespace"));
	Ожидаем.Что(АтрибутыЗаписиЗапроса.Получить("db.query.text")).Равно(Неопределено);

	// Операция хранилища - тоже вызов библиотеки из прикладного кода
	Операция = ЕдинственныйСпан("ВыполнитьСКоннектором");
	ЗаписиОперации = ПроцессорЛогов.ПоИмениСобытия("entity.operation.exception");
	Ожидаем.Что(ЗаписиОперации).ИмеетДлину(1);
	ПроверитьЗаписьИсключения(ЗаписиОперации[0], Операция);
	АтрибутыЗаписиОперации = ЗаписиОперации[0].Атрибуты();
	Ожидаем.Что(АтрибутыЗаписиОперации.Получить("code.function.name")).Равно("ВыполнитьСКоннектором");
	Ожидаем.Что(АтрибутыЗаписиОперации.Получить("entity.depth")).Равно(Операция.Атрибуты().Получить("entity.depth"));

КонецПроцедуры

&Тест
Процедура СПроцессоромСобытийИсключениеВидноВСпане() Экспорт

	// Дано - процессор событий ядра, как в автоконфигурации: запись пишется до завершения спана
	Логгер = Новый ОтелПровайдерЛогирования(Новый ОтелРесурс(), Новый ОтелПроцессорСобытийВСобытияСпана())
		.ПолучитьЛоггер("entity", "test");
	СоздатьМенеджерSQLite();
	Экспортер.Очистить();
	Контекст = Новый Структура("Текст", "SELECT * FROM НетТакойТаблицы");

	Ожидаем.Что(МенеджерСущностей)
		.Метод("ВыполнитьСКоннектором", ПараметрыВызова("Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)", Контекст))
		.ВыбрасываетИсключение("НетТакойТаблицы");

	События = ЕдинственныйСпан("SELECT").События();
	Ожидаем.Что(События).ИмеетДлину(1);
	Ожидаем.Что(События[0].Имя()).Равно("db.client.operation.exception");
	Ожидаем.Что(События[0].Атрибуты().Получить("exception.message")).Содержит("НетТакойТаблицы");

КонецПроцедуры

&Тест
Процедура БезЛоггераИсключениеНеПишется() Экспорт

	Логгер = Неопределено;
	СоздатьМенеджерSQLite();
	Экспортер.Очистить();
	Контекст = Новый Структура("Текст", "SELECT * FROM НетТакойТаблицы");

	Ожидаем.Что(МенеджерСущностей)
		.Метод("ВыполнитьСКоннектором", ПараметрыВызова("Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)", Контекст))
		.ВыбрасываетИсключение("НетТакойТаблицы");

	// Статус и error.type на спане остаются
	Операция = ЕдинственныйСпан("ВыполнитьСКоннектором");
	Ожидаем.Что(Операция.КодСтатуса()).Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Операция.События()).ИмеетДлину(0);
	Ожидаем.Что(ПроцессорЛогов.Записи()).ИмеетДлину(0);

КонецПроцедуры

// Спаны запросов

&Тест
Процедура ЗапросДаетКлиентскийСпанСАтрибутамиБД() Экспорт

	СоздатьМенеджерSQLite();
	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));
	Экспортер.Очистить();

	МенеджерСущностей.Получить(Тип("ФизическоеЛицо"));

	Спан = ЕдинственныйСпан("SELECT ФизическиеЛица");
	Атрибуты = Спан.Атрибуты();
	Ожидаем.Что(Спан.ВидСпана()).Равно(ОтелВидСпана.Клиент());
	Ожидаем.Что(Атрибуты.Получить("db.system.name")).Равно("sqlite");
	Ожидаем.Что(Атрибуты.Получить("db.namespace")).Равно(ФайлБазы);
	Ожидаем.Что(Атрибуты.Получить("db.collection.name")).Равно("ФизическиеЛица");
	Ожидаем.Что(Атрибуты.Получить("db.operation.name")).Равно("SELECT");
	Ожидаем.Что(Атрибуты.Получить("db.query.text")).Содержит("SELECT");
	Ожидаем.Что(Атрибуты.Получить("db.response.returned_rows")).Равно(1);
	Ожидаем.Что(Атрибуты.Получить("server.address"), "У файловой базы нет сервера").Равно(Неопределено);
	Ожидаем.Что(Атрибуты.Получить("server.port")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура КоннекторБезSqlДаетСпанБезТекстаЗапроса() Экспорт

	СоздатьМенеджерInMemory();
