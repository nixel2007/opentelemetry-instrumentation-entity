КонецПроцедуры

// Метрики

&Тест
Процедура ДлительностьЗапросаПишетсяВГистограммуSemconv() Экспорт

	СоздатьМенеджерInMemory();

	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));

	Данные = ДанныеМетрики("db.client.operation.duration");
	Ожидаем.Что(Данные.ЕдиницаИзмерения()).Равно("s");
	Ожидаем.Что(Данные.ТипМетрики()).Равно("histogram");

	Точка = ТочкаМетрики("db.client.operation.duration", "db.operation.name", "INSERT");
	Ожидаем.Что(Точка.Получить("count")).Равно(1);
	Ожидаем.Что(Точка.Получить("sum")).Меньше(10);
	Границы = Точка.Получить("explicitBounds");
	Ожидаем.Что(Границы).ИмеетДлину(9);
	Ожидаем.Что(Границы[0]).Равно(0.001);
	Ожидаем.Что(Границы[8]).Равно(10);
	Ожидаем.Что(Атрибут(Точка, "db.system.name")).Равно("inmemory");
	Ожидаем.Что(Атрибут(Точка, "db.collection.name")).Равно("ФизическиеЛица");
	Ожидаем.Что(Атрибут(Точка, "error.type")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ДлительностьОперацииИСущностиСчитаютсяПоТипу() Экспорт

	СоздатьМенеджерInMemory();

	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));
	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Гоголь"));
	МенеджерСущностей.Получить(Тип("ФизическоеЛицо"));

	Ожидаем.Что(ДанныеМетрики("entity.operation.duration").ЕдиницаИзмерения()).Равно("s");
	Сохранения = ТочкаМетрики("entity.operation.duration", "entity.operation", "Сохранить");
	Ожидаем.Что(Сохранения.Получить("count")).Равно(2);
	Ожидаем.Что(Атрибут(Сохранения, "entity.type")).Равно("ФизическоеЛицо");

	Ожидаем.Что(ТочкаМетрики("entity.entities", "entity.operation", "Сохранить").Получить("value")).Равно(2);
	Ожидаем.Что(ТочкаМетрики("entity.entities", "entity.operation", "Получить").Получить("value")).Равно(2);

КонецПроцедуры

&Тест
Процедура ТранзакцииСчитаютсяПоИсходу() Экспорт

	СоздатьМенеджерSQLite();

	МенеджерСущностей.НачатьТранзакцию();
	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));
	МенеджерСущностей.ЗафиксироватьТранзакцию();
	МенеджерСущностей.НачатьТранзакцию();
	МенеджерСущностей.ОтменитьТранзакцию();

	Ожидаем.Что(ТочкаМетрики("entity.transactions", "entity.transaction.result", "commit").Получить("value")).Равно(1);
	Ожидаем.Что(ТочкаМетрики("entity.transactions", "entity.transaction.result", "rollback").Получить("value")).Равно(1);
	Ожидаем.Что(Экспортер.ПоИмени("COMMIT"), "Фиксация - обычный клиентский спан запроса").ИмеетДлину(1);
	Ожидаем.Что(Экспортер.ПоИмени("Транзакция"), "Долгоживущего спана транзакции нет").ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура СостояниеПулаПишетсяИзСнимкаСобытияСоединения() Экспорт

	СоздатьМенеджерInMemory();

	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));

	Ожидаем.Что(ТочкаМетрики("db.client.connection.count", "db.client.connection.state", "idle").Получить("value")).Равно(1);
	Ожидаем.Что(ТочкаМетрики("db.client.connection.count", "db.client.connection.state", "used").Получить("value")).Равно(0);
	Ожидаем.Что(ЕдинственнаяТочка("db.client.connection.max").Получить("value")).Равно(10);
	Ожидаем.Что(ЕдинственнаяТочка("db.client.connection.pending_requests").Получить("value")).Равно(0);

	ИмяПула = Атрибут(ЕдинственнаяТочка("db.client.connection.max"), "db.client.connection.pool.name");
	Ожидаем.Что(Лев(ИмяПула, 9)).Равно("inmemory:");

	Ожидание = ЕдинственнаяТочка("db.client.connection.wait_time");
	Ожидаем.Что(ДанныеМетрики("db.client.connection.wait_time").ЕдиницаИзмерения()).Равно("s");
	Ожидаем.Что(Ожидание.Получить("count"), "Инициализация и сохранение занимали соединение").Равно(2);
	Ожидаем.Что(ЕдинственнаяТочка("db.client.connection.create_time").Получить("count"), "Открыто одно соединение").Равно(1);

КонецПроцедуры

// Параллельные потоки

&Тест
Процедура ПараллельныйПрогревКэшаАтрибутовНеЛомаетМетрики() Экспорт

	// Наблюдатель вызывается в потоке операции, поэтому на холодном кэше потоки одновременно
	// промахиваются по одним и тем же ключам и одновременно дописывают кэш атрибутов.
	// Метр-заглушка, в отличие от синхронизированных инструментов SDK, не выстраивает потоки в очередь.
	// Гонка вероятностная, поэтому прогрев повторяется на свежих наблюдателях.
	КоличествоПрогревов = 20;
	КоличествоПотоков = 16;
	КоличествоИсходов = 1000;

	// Сбор покрытия OneScript регистрирует строку при первом исполнении в несинхронизированном
	// словаре и падает, если потоки впервые исполняют строку одновременно. Прогон в этом потоке
	// регистрирует строки заранее, чтобы тест ловил гонку наблюдателя, а не движка.
	ЗавершитьТранзакцииВФоне(Новый ОтелНаблюдательИсточникаДанных(Неопределено, Новый ЗаглушкаМетра), 1);

	Для Прогрев = 1 По КоличествоПрогревов Цикл

		Наблюдатель = Новый ОтелНаблюдательИсточникаДанных(Неопределено, Новый ЗаглушкаМетра);

		ПараметрыЗадания = ПараметрыВызова(Наблюдатель, КоличествоИсходов);
		Задания = Новый Массив;
		Пока Задания.Количество() < КоличествоПотоков Цикл
			Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ЗавершитьТранзакцииВФоне", ПараметрыЗадания));
		КонецЦикла;
		ФоновыеЗадания.ОжидатьВсе(Задания);

		Для Каждого Задание Из Задания Цикл
			Ожидаем.Что(Задание.ИнформацияОбОшибке, СтрШаблон("Прогрев %1: поток записи метрик завершился без ошибок", Прогрев))
				.Равно(Неопределено);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Настройки и выключение

&Тест
Процедура ВыключенныйТрассировщикНеМешаетМетрикам() Экспорт

	ПодготовитьСдк(Ложь);
	СоздатьМенеджерInMemory();

	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));

	Ожидаем.Что(Экспортер.Спаны, "Незаписывающие спаны не экспортируются").ИмеетДлину(0);
	Ожидаем.Что(ОтелКонтекст.ТекущийСпан()).Равно(Неопределено);
	Ожидаем.Что(ТочкаМетрики("entity.operation.duration", "entity.operation", "Сохранить").Получить("count")).Равно(1);

КонецПроцедуры

&Тест
Процедура МетрикиОтключаютсяНастройкой() Экспорт

	СоздатьМенеджерInMemory(Новый Структура("Метрики", Ложь));

	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));

	Ожидаем.Что(Метр.Инструменты(), "Инструменты не создаются").ИмеетДлину(0);
	Ожидаем.Что(Экспортер.ПоИмени("Сохранить ФизическоеЛицо")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура БезТрассировщикаИМетраНаблюдательМолчит() Экспорт

	Трассировщик = Неопределено;
	Метр = Неопределено;
	СоздатьМенеджерInMemory();

	МенеджерСущностей.Сохранить(НовоеФизическоеЛицо("Пушкин"));

	Ожидаем.Что(Экспортер.Спаны).ИмеетДлину(0);
	Ожидаем.Что(МенеджерСущностей.Получить(Тип("ФизическоеЛицо"))).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура БезТрассировщикаИсключениеПишетсяЗаписьюЛога() Экспорт

	// Дано - спанов нет, логгер есть
	Трассировщик = Неопределено;
	СоздатьМенеджерSQLite();

	// Когда
	ВыполнитьЗапросКНесуществующейТаблице();

	// Тогда - исключение записывается и без трассы, без контекста спана
	Записи = ПроцессорЛогов.ПоИмениСобытия("db.client.operation.exception");
	Ожидаем.Что(Записи).ИмеетДлину(1);
	Ожидаем.Что(Записи[0].Атрибуты().Получить("exception.message")).Содержит("НетТакойТаблицы");
	Ожидаем.Что(Записи[0].Атрибуты().Получить("exception.stacktrace")).Содержит("НетТакойТаблицы");
	Ожидаем.Что(Записи[0].Атрибуты().Получить("db.system.name")).Равно("sqlite");
	Ожидаем.Что(Записи[0].ИдСпана(), "Спана нет - нет и контекста").Равно("");
	Ожидаем.Что(ПроцессорЛогов.ПоИмениСобытия("entity.operation.exception")).ИмеетДлину(1);

КонецПроцедуры

&Тест
Процедура БезТрассировщикаИМетраОшибкаНеКлассифицируется() Экспорт

	// Дано - error.type писать некуда
	Трассировщик = Неопределено;
	Метр = Неопределено;
	Логгер = Неопределено;
	Классификатор = КлассификаторОшибкиСУБД();
	СоздатьМенеджерSQLite();

	// Когда
	ВыполнитьЗапросКНесуществующейТаблице();

	// Тогда - классификация стоит 1-2 мс и без спана и метрики не нужна
	Ожидаем.Что(Классификатор.Вызовов).Равно(0);

КонецПроцедуры

// Служебные

Процедура ПодготовитьСдк(Знач ТрассировщикВключен)

	Экспортер = Новый ЭкспортерСпановВПамяти;
	Ресурс = Новый ОтелРесурс();
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс, Новый ОтелПростойПроцессорСпанов(Экспортер));
	Область = Новый ОтелОбластьИнструментирования("entity", "test");
	Трассировщик = Новый ОтелТрассировщик(Область, ПровайдерТрассировки, НЕ ТрассировщикВключен);

	ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс);
	Метр = ПровайдерМетрик.ПостроительМетра("entity").Построить();

	ПроцессорЛогов = Новый ПроцессорЛоговВПамяти;
	Логгер = Новый ОтелПровайдерЛогирования(Ресурс, ПроцессорЛогов).ПолучитьЛоггер("entity", "test");

КонецПроцедуры

// Проверяет запись исключения: серьезность WARN, атрибуты exception.* и контекст спана операции.
//
// Параметры:
//   Запись - ОтелЗаписьЛога - Запись исключения.
//   Спан - ОтелСпан - Спан, к которому относится запись.
//
Процедура ПроверитьЗаписьИсключения(Знач Запись, Знач Спан)

	Ожидаем.Что(Запись.НомерСерьезности()).Равно(ОтелСтепеньСерьезности.Warn());
	Ожидаем.Что(Запись.Атрибуты().Получить("exception.message")).Содержит("НетТакойТаблицы");
	Ожидаем.Что(Запись.Атрибуты().Получить("exception.stacktrace")).Содержит("НетТакойТаблицы");
	Ожидаем.Что(Запись.ИдТрассировки()).Равно(Спан.КонтекстСпана().ИдТрассировки());
	Ожидаем.Что(Запись.ИдСпана()).Равно(ИдСпана(Спан));

КонецПроцедуры

// Устанавливает классификатор нативных ошибок ядра, который любую ошибку относит к db.table.not_found
// и считает вызовы. Сбрасывается после каждого теста.
//
// Возвращаемое значение:
//   Произвольный - Классификатор со счетчиком Вызовов.
//
Функция КлассификаторОшибкиСУБД()

	Классификатор = ЗагрузитьСценарийИзСтроки("
	|Перем Вызовов Экспорт;
	|Функция Классифицировать(Ошибка) Экспорт
	|	Вызовов = Вызовов + 1;
	|	Попытка
	|		ВызватьИсключение ФабрикаОшибок.Создать(""db.table.not_found"", Ошибка.Описание);
	|	Исключение
	|		Возврат ИнформацияОбОшибке();
	|	КонецПопытки;
	|КонецФункции");
	Классификатор.Вызовов = 0;
	ОтелУтилиты.УстановитьКлассификаторНативныхОшибок(Классификатор);

	Возврат Классификатор;

КонецФункции

Процедура ВыполнитьЗапросКНесуществующейТаблице()
	Контекст = Новый Структура("Текст", "SELECT * FROM НетТакойТаблицы");
	Ожидаем.Что(МенеджерСущностей)
		.Метод("ВыполнитьСКоннектором", ПараметрыВызова("Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)", Контекст))
		.ВыбрасываетИсключение("НетТакойТаблицы");
КонецПроцедуры

Процедура СоздатьМенеджерInMemory(Знач Настройки = Неопределено)
	СоздатьМенеджер(Тип("КоннекторInMemory"), Строка(Новый УникальныйИдентификатор), Настройки);
КонецПроцедуры

Процедура СоздатьМенеджерSQLite(Знач Настройки = Неопределено)
	ФайлБазы = ПолучитьИмяВременногоФайла("sqlite");
	СоздатьМенеджер(Тип("КоннекторSQLite"), "Data Source=" + ФайлБазы, Настройки);
КонецПроцедуры

Процедура СоздатьМенеджер(Знач ТипКоннектора, Знач СтрокаСоединения, Знач Настройки)

	Источник = Новый ИсточникДанных("тест", ТипКоннектора, СтрокаСоединения);
	Источник.ДобавитьНаблюдателя(Новый ОтелНаблюдательИсточникаДанных(Трассировщик, Метр, Логгер, Настройки));

	МенеджерСущностей = Новый МенеджерСущностей(Источник);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СтранаМира"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("ФизическоеЛицо"));
	МенеджерСущностей.Инициализировать();

КонецПроцедуры

Функция НовоеФизическоеЛицо(Знач Имя)
	Лицо = Новый ФизическоеЛицо;
	Лицо.Имя = Имя;
	Возврат Лицо;
КонецФункции

Функция ЕдинственныйСпан(Знач Имя)
	Спаны = Экспортер.ПоИмени(Имя);
	Ожидаем.Что(Спаны, "Ожидался один спан " + Имя + ", экспортированы: " + ИменаСпанов()).ИмеетДлину(1);
	Возврат Спаны[0];
КонецФункции

Функция ИменаСпанов()
	Имена = Новый Массив;
	Для Каждого Спан Из Экспортер.Спаны Цикл
		Имена.Добавить(Спан.Имя());
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

Функция ИдСпана(Знач Спан)
	Возврат Спан.КонтекстСпана().ИдСпана();
КонецФункции

Функция ДанныеМетрики(Знач Имя)
	Для Каждого Инструмент Из Метр.Инструменты() Цикл
		Если Инструмент.Имя() = Имя Тогда
			Возврат Инструмент.Собрать(Метр.Ресурс(), Метр.ОбластьИнструментирования(), Инструмент.Имя(), Инструмент.Описание());
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Метрика не найдена: " + Имя;
КонецФункции

Функция ТочкиМетрики(Знач Имя)
	Возврат ДанныеМетрики(Имя).ТочкиДанных();
КонецФункции

Функция ЕдинственнаяТочка(Знач Имя)
	Точки = ТочкиМетрики(Имя);
	Ожидаем.Что(Точки, "Ожидалась одна точка данных " + Имя).ИмеетДлину(1);
	Возврат Точки[0];
КонецФункции

Функция ТочкаМетрики(Знач Имя, Знач КлючАтрибута, Знач ЗначениеАтрибута)
	Для Каждого Точка Из ТочкиМетрики(Имя) Цикл
		Если Атрибут(Точка, КлючАтрибута) = ЗначениеАтрибута Тогда
			Возврат Точка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Точка %1 с %2 = %3 не найдена", Имя, КлючАтрибута, ЗначениеАтрибута);
КонецФункции

// Атрибуты точки данных лежат в формате OTLP: массив пар key и value, где value - соответствие
// с единственным типизированным полем (stringValue, intValue, doubleValue, boolValue).
Функция Атрибут(Знач Точка, Знач Ключ)
	Для Каждого Пара Из Точка.Получить("attributes") Цикл
		Если Пара.Получить("key") = Ключ Тогда
			Для Каждого Типизированное Из Пара.Получить("value") Цикл
				Возврат Типизированное.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Точка входа фонового задания: события транзакций с исходами в одном и том же порядке во всех
// потоках, чтобы потоки промахивались по кэшу одновременно.
//
// Параметры:
//   Наблюдатель - ОтелНаблюдательИсточникаДанных - Наблюдатель, общий для всех потоков.
//   КоличествоИсходов - Число - Сколько разных исходов отправить.
//
Процедура ЗавершитьТранзакцииВФоне(Знач Наблюдатель, Знач КоличествоИсходов) Экспорт
	Для Номер = 1 По КоличествоИсходов Цикл
		Наблюдатель.ПослеСобытия(Новый ЗаглушкаСобытияТранзакции("исход" + Формат(Номер, "ЧГ=")));
	КонецЦикла;
КонецПроцедуры

Функция ПараметрыВызова(Знач Первый, Знач Второй)
	Параметры = Новый Массив;
	Параметры.Добавить(Первый);
	Параметры.Добавить(Второй);
	Возврат Параметры;
КонецФункции
