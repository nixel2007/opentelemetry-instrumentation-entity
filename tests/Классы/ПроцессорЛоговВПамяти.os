// Процессор логов для тестов: складывает записи логов в массив в момент записи.

// Массив из ОтелЗаписьЛога - Записи логов в порядке записи.
Перем Записи Экспорт;

&Реализует("ИнтерфейсПроцессорЛогов")
Процедура ПриСозданииОбъекта()
	Записи = Новый Массив;
КонецПроцедуры

// Запоминает запись лога.
//
// Параметры:
//   ЗаписьЛога - ОтелЗаписьЛога - Запись лога.
//   Контекст - Соответствие, Неопределено - Не используется.
//
Процедура ПриПоявлении(ЗаписьЛога, Контекст = Неопределено) Экспорт // BSLLS:UnusedParameters-off
	Записи.Добавить(ЗаписьЛога);
КонецПроцедуры

// Принимает все записи.
//
// Параметры:
//   Контекст - Соответствие, Неопределено - Не используется.
//   ОбластьИнструментирования - ОтелОбластьИнструментирования - Не используется.
//   СтепеньСерьезности - Число - Не используется.
//   ИмяСобытия - Строка - Не используется.
//
// Возвращаемое значение:
//   Булево - Истина.
//
// BSLLS:NumberOfOptionalParams-off
// BSLLS:UnusedParameters-off
Функция Включен(Контекст = Неопределено, ОбластьИнструментирования = Неопределено,
	СтепеньСерьезности = 0, ИмяСобытия = "") Экспорт
// BSLLS:NumberOfOptionalParams-on
// BSLLS:UnusedParameters-on
	Возврат Истина;
КонецФункции

// Ничего не буферизует.
//
// Параметры:
//   ТаймаутМс - Число - Не используется.
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - Успех.
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
	Возврат ОтелРезультатыЭкспорта.Успех();
КонецФункции

// Ничего не закрывает.
//
// Параметры:
//   ТаймаутМс - Число - Не используется.
//
// Возвращаемое значение:
//   ОтелРезультатЗакрытия - Успех.
//
Функция Закрыть(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
	Возврат ОтелРезультатыЗакрытия.Успех();
КонецФункции

// Возвращает записи с заданным именем события.
//
// Параметры:
//   ИмяСобытия - Строка - Имя события записи.
//
// Возвращаемое значение:
//   Массив из ОтелЗаписьЛога - Записи с этим именем события.
//
Функция ПоИмениСобытия(Знач ИмяСобытия) Экспорт
	Результат = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись.ИмяСобытия() = ИмяСобытия Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
