// Экспортер спанов для тестов: складывает завершенные спаны в массив.
//
// Подключается к ОтелПростойПроцессорСпанов, поэтому получает спан сразу по завершении.

// Массив из ОтелСпан - Экспортированные спаны в порядке завершения.
Перем Спаны Экспорт;

&Реализует("ИнтерфейсЭкспортерСпанов")
Процедура ПриСозданииОбъекта()
	Спаны = Новый Массив;
КонецПроцедуры

// Запоминает переданные спаны.
//
// Параметры:
//   МассивСпанов - Массив из ОтелСпан - Спаны на экспорт.
//   Таймаут - Число, Неопределено - Не используется.
//
// Возвращаемое значение:
//   ОтелРезультатЭкспорта - Успех.
//
Функция Экспортировать(МассивСпанов, Таймаут = Неопределено) Экспорт // BSLLS:UnusedParameters-off
	Для Каждого Спан Из МассивСпанов Цикл
		Спаны.Добавить(Спан);
	КонецЦикла;
	Возврат ОтелРезультатыЭкспорта.Успех();
КонецФункции

// Ничего не буферизует.
//
// Параметры:
//   ТаймаутМс - Число - Не используется.
//
// Возвращаемое значение:
//   Булево - Истина.
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт // BSLLS:UnusedParameters-off
	Возврат Истина;
КонецФункции

// Ничего не закрывает.
//
// Возвращаемое значение:
//   Булево - Истина.
//
Функция Закрыть() Экспорт
	Возврат Истина;
КонецФункции

// Забывает экспортированные спаны.
//
Процедура Очистить() Экспорт
	Спаны = Новый Массив;
КонецПроцедуры

// Находит экспортированные спаны по имени.
//
// Параметры:
//   Имя - Строка - Имя спана.
//
// Возвращаемое значение:
//   Массив из ОтелСпан - Спаны с таким именем в порядке завершения.
//
Функция ПоИмени(Знач Имя) Экспорт
	Результат = Новый Массив;
	Для Каждого Спан Из Спаны Цикл
		Если Спан.Имя() = Имя Тогда
			Результат.Добавить(Спан);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции
