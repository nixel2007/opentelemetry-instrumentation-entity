// ОтелИнструментированиеХранилищаСущностей: спаны и гистограмма вокруг вызовов методов
// хранилища сущностей.
//
// Инструментирование получает объект хранилища сущностей и его имя и возвращает обертку.
// SDK на провайдерах в памяти: спаны собирает ЭкспортерСпановВПамяти, метрики читаются
// прямо с инструментов метра.
//
// BSLLS:MagicNumber-off
// BSLLS:DuplicateStringLiteral-off

#Использовать ".."
#Использовать "."
#Использовать opentelemetry
#Использовать asserts

// ЭкспортерСпановВПамяти - Получает завершенные спаны.
Перем Экспортер;
// ОтелТрассировщик - Трассировщик инструментирования.
Перем Трассировщик;
// ОтелМетр - Метр инструментирования.
Перем Метр;

&ПередКаждым
Процедура ПередЗапускомТеста() Экспорт

	ОтелКонтекст.Очистить();

	Экспортер = Новый ЭкспортерСпановВПамяти;
	Ресурс = Новый ОтелРесурс(Истина);
	ПровайдерТрассировки = Новый ОтелПровайдерТрассировки(Ресурс, Новый ОтелПростойПроцессорСпанов(Экспортер));
	Область = Новый ОтелОбластьИнструментирования("entity", "test");
	Трассировщик = Новый ОтелТрассировщик(Область, ПровайдерТрассировки, Новый ОтелКонфигурацияТрассировщика(Истина));

	ПровайдерМетрик = Новый ОтелПровайдерМетрик(Ресурс);
	Метр = ПровайдерМетрик.ПостроительМетра("entity").Построить();

КонецПроцедуры

&Тест
Процедура ВызовМетодаДаетСпанСАтрибутамиКода() Экспорт

	// Дано
	ХранилищеСущностей = Обернуть(Новый ЗаглушкаХранилищаСущностей, "ХранилищеФизическиеЛица");

	// Когда
	Результат = ХранилищеСущностей.Получить();

	// Тогда
	Ожидаем.Что(Результат, "Обертка возвращает результат метода без изменений").Равно("получено");

	Спан = ЕдинственныйСпан("ХранилищеФизическиеЛица.Получить");
	Ожидаем.Что(Спан.Атрибуты().Получить("code.function.name")).Равно("Получить");
	Ожидаем.Что(Спан.Атрибуты().Получить("code.namespace")).Равно("ХранилищеФизическиеЛица");

КонецПроцедуры

&Тест
Процедура ДлительностьПишетсяВГистограммуВСекундахСоСтатусомSuccess() Экспорт

	// Дано
	ХранилищеСущностей = Обернуть(Новый ЗаглушкаХранилищаСущностей, "ХранилищеФизическиеЛица");

	// Когда - метод заглушки спит 20 мс, два вызова дают сумму в сотые доли секунды
	ХранилищеСущностей.Подождать();
	ХранилищеСущностей.Подождать();

	// Тогда
	Данные = ДанныеМетрики("entity.repository.invocations");
	Ожидаем.Что(Данные.ЕдиницаИзмерения()).Равно("s");

	Точка = ТочкаМетрики(Данные, "code.function.name", "Подождать");
	Ожидаем.Что(Атрибут(Точка, "entity.repository")).Равно("ХранилищеФизическиеЛица");
	Ожидаем.Что(Точка.Получить("count")).Равно(2);
	Ожидаем.Что(Точка.Получить("sum"), "Две задержки по 20 мс видны в секундах").БольшеИлиРавно(0.02);
	Ожидаем.Что(Точка.Получить("sum"), "Длительность в секундах, а не в миллисекундах").Меньше(1);
	Ожидаем.Что(Атрибут(Точка, "entity.repository.state")).Равно("success");
	Ожидаем.Что(Атрибут(Точка, "error.type")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОшибкаМетодаПопадаетВСпанИГистограмму() Экспорт

	// Дано
	ХранилищеСущностей = Обернуть(Новый ЗаглушкаХранилищаСущностей, "ХранилищеФизическиеЛица");

	// Когда
	Ожидаем.Что(ХранилищеСущностей).Метод("Упасть").ВыбрасываетИсключение("Хранилище сущностей не смогло");

	// Тогда
	Спан = ЕдинственныйСпан("ХранилищеФизическиеЛица.Упасть");
	Ожидаем.Что(Спан.КодСтатуса()).Равно(ОтелКодСтатуса.Ошибка());
	Ожидаем.Что(Спан.Атрибуты().Получить("error.type")).Не_().Равно(Неопределено);
	Ожидаем.Что(Спан.События(), "Исключение записано событием спана").ИмеетДлину(1);

	Точка = ТочкаМетрики(ДанныеМетрики("entity.repository.invocations"), "code.function.name", "Упасть");
	Ожидаем.Что(Атрибут(Точка, "entity.repository.state")).Равно("error");
	Ожидаем.Что(Атрибут(Точка, "error.type")).Не_().Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура МетодыБезОбращенияКБДНеОборачиваются() Экспорт

	// Дано
	ХранилищеСущностей = Обернуть(Новый ЗаглушкаХранилищаСущностей, "ХранилищеФизическиеЛица");

	// Когда
	ХранилищеСущностей.ПолучитьОбъектМодели();
	ХранилищеСущностей.СоздатьЭлемент();

	// Тогда
	Ожидаем.Что(Экспортер.Спаны, "Методы, не ходящие в БД, спанов не дают: " + ИменаСпанов())
		.ИмеетДлину(0);

КонецПроцедуры

&Тест
Процедура ХранилищеСущностейБезПодходящихМетодовВозвращаетсяКакЕсть() Экспорт

	// Дано
	Исходное = Новый ХранилищеСущностейБезЗапросов;

	// Когда
	Обернутое = Обернуть(Исходное, "ХранилищеСущностейБезЗапросов");

	// Тогда: оборачивать нечего, и подменять объект пустой оберткой незачем
	Ожидаем.Что(Обернутое = Исходное, "Возвращается тот же объект").Равно(Истина);

КонецПроцедуры

// Служебные

Функция Обернуть(Знач ХранилищеСущностей, Знач ИмяХранилищаСущностей)
	Инструментирование = Новый ОтелИнструментированиеХранилищаСущностей(Трассировщик, Метр);
	Возврат Инструментирование.Обернуть(ХранилищеСущностей, ИмяХранилищаСущностей);
КонецФункции

Функция ЕдинственныйСпан(Знач Имя)
	Спаны = Экспортер.ПоИмени(Имя);
	Ожидаем.Что(Спаны, "Ожидался один спан " + Имя + ", экспортированы: " + ИменаСпанов()).ИмеетДлину(1);
	Возврат Спаны[0];
КонецФункции

Функция ИменаСпанов()
	Имена = Новый Массив;
	Для Каждого Спан Из Экспортер.Спаны Цикл
		Имена.Добавить(Спан.Имя());
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");
КонецФункции

Функция ДанныеМетрики(Знач Имя)
	Для Каждого Инструмент Из Метр.Инструменты() Цикл
		Если Инструмент.Имя() = Имя Тогда
			Возврат Инструмент.Собрать(Метр.Ресурс(), Метр.ОбластьИнструментирования(), Инструмент.Имя(), Инструмент.Описание());
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Метрика не найдена: " + Имя;
КонецФункции

Функция ТочкаМетрики(Знач Данные, Знач КлючАтрибута, Знач ЗначениеАтрибута)
	Для Каждого Точка Из Данные.ТочкиДанных() Цикл
		Если Атрибут(Точка, КлючАтрибута) = ЗначениеАтрибута Тогда
			Возврат Точка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Точка с %1 = %2 не найдена", КлючАтрибута, ЗначениеАтрибута);
КонецФункции

Функция Атрибут(Знач Точка, Знач Ключ)
	Для Каждого Пара Из Точка.Получить("attributes") Цикл
		Если Пара.Получить("key") = Ключ Тогда
			Для Каждого Типизированное Из Пара.Получить("value") Цикл
				Возврат Типизированное.Значение;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
