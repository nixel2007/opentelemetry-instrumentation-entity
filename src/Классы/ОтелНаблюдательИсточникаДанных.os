// Наблюдатель источника данных entity, переводящий его события в спаны и метрики
// OpenTelemetry.
//
// Регистрируется на менеджере методом ДобавитьНаблюдателя и с этого момента:
//   * операции менеджера и хранилищ (Сохранить, Получить, Удалить и другие) становятся
//     спанами INTERNAL с атрибутами code.* и entity.*; вложенные операции - дочерними спанами;
//   * запросы к СУБД становятся спанами CLIENT с атрибутами db.* и server.*, вложенными
//     в спан операции; текст запроса с плейсхолдерами - в db.query.text;
//   * длительности запросов и операций пишутся в гистограммы db.client.operation.duration
//     и entity.operation.duration в секундах, сущности и транзакции считаются счетчиками,
//     состояние пула соединений отдается наблюдаемыми счетчиками db.client.connection.*.
//
// Соединения и транзакции спанов не дают: BEGIN, COMMIT и ROLLBACK приходят обычными
// спанами запроса, а долгоживущий спан транзакции только мешал бы читать трейс.
//
// Пример:
//   Наблюдатель = Новый ОтелНаблюдательИсточникаДанных(
//       ОтелSdk.ПолучитьТрассировщик("entity"),
//       ОтелSdk.ПолучитьМетр("entity")
//   );
//   МенеджерСущностей.ДобавитьНаблюдателя(Наблюдатель);
//
#Использовать entity
#Использовать opentelemetry

// ОтелТрассировщик, Неопределено - Трассировщик спанов; без него спаны не создаются.
Перем Трассировщик;
// Булево - Признак записи текста запроса в db.query.text.
Перем ВключатьТекстЗапроса;
// Структура, Неопределено - Инструменты метрик; Неопределено, если метрики выключены.
Перем Инструменты;
// Соответствие - Готовые наборы атрибутов по ключу: наборы создаются один раз на сочетание
// значений, а не на каждое событие. Наборы с error.type не кэшируются - ошибки редки.
Перем КэшАтрибутов;
// Соответствие - Последние снимки пулов по имени пула: Занято, Свободно, Ожидает, Предел.
// Их читают наблюдаемые счетчики при сборе метрик, а не пишут датчики на каждое событие.
Перем СнимкиПулов;

// Конструктор.
//
// Параметры:
//   ПТрассировщик - ОтелТрассировщик, Неопределено - Трассировщик, которым создаются спаны.
//     Неопределено выключает трассировку.
//   ПМетр - ОтелМетр, Неопределено - Метр, в котором регистрируются инструменты.
//     Неопределено выключает метрики.
//   Настройки - Структура, Неопределено - Настройки наблюдателя:
//     * ТекстЗапроса - Булево - Писать текст запроса в атрибут db.query.text. По умолчанию Истина.
//     * Метрики - Булево - Регистрировать инструменты и писать метрики. По умолчанию Истина.
//
&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта(Знач ПТрассировщик, Знач ПМетр = Неопределено, Знач Настройки = Неопределено)

	Трассировщик = ПТрассировщик;
	ВключатьТекстЗапроса = Настройка(Настройки, "ТекстЗапроса", Истина);
	КэшАтрибутов = Новый Соответствие;
	СнимкиПулов = Новый Соответствие;

	Если ПМетр <> Неопределено И Настройка(Настройки, "Метрики", Истина) Тогда
		Инструменты = СоздатьИнструменты(ПМетр);
	КонецЕсли;

КонецПроцедуры

// Начинает спан операции или запроса и делает его текущим.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных - Начатое событие.
//
Процедура ПередСобытием(Событие) Экспорт

	Если Трассировщик = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Событие.Вид() = ВидыСобытийИсточникаДанных.Операция() Тогда
		Спан = Трассировщик.НачатьСпан(ИмяСпанаОперации(Событие), ОтелВидСпана.Внутренний(), АтрибутыСпанаОперации(Событие));
	ИначеЕсли Событие.Вид() = ВидыСобытийИсточникаДанных.Запрос() Тогда
		Спан = Трассировщик.НачатьСпан(ИмяСпанаЗапроса(Событие), ОтелВидСпана.Клиент(), АтрибутыСпанаЗапроса(Событие));
	Иначе
		Возврат;
	КонецЕсли;

	// Спан делается текущим, чтобы вложенные события стали его потомками; область закрывается
	// в ПослеСобытия - события одного потока приходят строго вложенно.
	Событие.УстановитьСостояние(Новый Структура("Спан, Токен", Спан, Спан.СделатьТекущим()));

КонецПроцедуры

// Завершает спан события и пишет метрики.
//
// Параметры:
//   Событие - СобытиеИсточникаДанных - Завершенное событие.
//
Процедура ПослеСобытия(Событие) Экспорт

	ЗавершитьСпан(Событие);

	Если Инструменты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вид = Событие.Вид();
	Если Вид = ВидыСобытийИсточникаДанных.Операция() Тогда
		ЗаписатьМетрикиОперации(Событие);
	ИначеЕсли Вид = ВидыСобытийИсточникаДанных.Запрос() Тогда
		ЗаписатьМетрикиЗапроса(Событие);
	ИначеЕсли Вид = ВидыСобытийИсточникаДанных.Соединение() Тогда
		ЗаписатьМетрикиСоединения(Событие);
	ИначеЕсли Вид = ВидыСобытийИсточникаДанных.Транзакция() Тогда
		ЗаписатьМетрикиТранзакции(Событие);
	КонецЕсли;

КонецПроцедуры

// Отдает число соединений пулов по состояниям при сборе метрик.
//
// Параметры:
//   Наблюдение - ОтелНаблюдениеМетрики - Куда записывать значения.
//
Процедура НаблюдатьСоединения(Наблюдение) Экспорт

	Для Каждого ИмяИСнимок Из СнимкиПулов Цикл
		Снимок = ИмяИСнимок.Значение;
		Наблюдение.Записать(Снимок.Занято, Снимок.АтрибутыЗанято);
		Наблюдение.Записать(Снимок.Свободно, Снимок.АтрибутыСвободно);
	КонецЦикла;

КонецПроцедуры

// Отдает размер пулов при сборе метрик.
//
// Параметры:
//   Наблюдение - ОтелНаблюдениеМетрики - Куда записывать значения.
//
Процедура НаблюдатьПределСоединений(Наблюдение) Экспорт

	Для Каждого ИмяИСнимок Из СнимкиПулов Цикл
		Наблюдение.Записать(ИмяИСнимок.Значение.Предел, ИмяИСнимок.Значение.АтрибутыПула);
	КонецЦикла;

КонецПроцедуры

// Отдает число потоков исполнения в очереди за соединением при сборе метрик.
//
// Параметры:
//   Наблюдение - ОтелНаблюдениеМетрики - Куда записывать значения.
//
Процедура НаблюдатьОжидающиеЗапросы(Наблюдение) Экспорт

	Для Каждого ИмяИСнимок Из СнимкиПулов Цикл
		Наблюдение.Записать(ИмяИСнимок.Значение.Ожидает, ИмяИСнимок.Значение.АтрибутыПула);
	КонецЦикла;

КонецПроцедуры

// Спаны

Функция ИмяСпанаОперации(Знач Событие)

	Если Событие.ТипСущности() = Неопределено Тогда
		Возврат Событие.Операция();
	КонецЕсли;

	Возврат Событие.Операция() + " " + Строка(Событие.ТипСущности());

КонецФункции

Функция ИмяСпанаЗапроса(Знач Событие)

	Если ПустаяСтрока(Событие.ИмяТаблицы()) Тогда
		Возврат Событие.Операция();
	КонецЕсли;

	Возврат Событие.Операция() + " " + Событие.ИмяТаблицы();

КонецФункции

Функция АтрибутыСпанаОперации(Знач Событие)

	Атрибуты = Новый Соответствие;
	Атрибуты.Вставить(ОтелСемантическиеСоглашения.ПространствоИменКода(), "МенеджерСущностей");
	Атрибуты.Вставить(ОтелСемантическиеСоглашения.ИмяФункцииКода(), Событие.Операция());
	Атрибуты.Вставить("entity.depth", Событие.Глубина());

	Если Событие.ТипСущности() <> Неопределено Тогда
		Атрибуты.Вставить("entity.type", Строка(Событие.ТипСущности()));
	КонецЕсли;
	Если НЕ ПустаяСтрока(Событие.ИмяТаблицы()) Тогда
		Атрибуты.Вставить("entity.table", Событие.ИмяТаблицы());
	КонецЕсли;

	Возврат Атрибуты;

КонецФункции

Функция АтрибутыСпанаЗапроса(Знач Событие)

	Атрибуты = Новый Соответствие;
	ЗаполнитьАтрибутыБД(Атрибуты, Событие);

	Если ВключатьТекстЗапроса И Событие.ТекстЗапроса() <> Неопределено Тогда
		Атрибуты.Вставить(ОтелСемантическиеСоглашения.ТекстЗапросаБД(), Событие.ТекстЗапроса());
	КонецЕсли;

	Возврат Атрибуты;

КонецФункции

// Заполняет атрибуты db.* и server.* - общие для спана запроса и его гистограммы.
//
// Параметры:
//   Атрибуты - Соответствие, ОтелАтрибуты - Куда писать; у обоих есть Вставить и Установить
//     соответственно, поэтому запись идет через ДобавитьАтрибут.
//   Событие - СобытиеИсточникаДанных - Событие запроса.
//
Процедура ЗаполнитьАтрибутыБД(Атрибуты, Знач Событие)

	ДобавитьАтрибут(Атрибуты, ОтелСемантическиеСоглашения.СистемаБД(), Событие.Система());
	ДобавитьАтрибут(Атрибуты, ОтелСемантическиеСоглашения.ИмяОперацииБД(), Событие.Операция());

	Если НЕ ПустаяСтрока(Событие.БазаДанных()) Тогда
		ДобавитьАтрибут(Атрибуты, ОтелСемантическиеСоглашения.ПространствоИменБД(), Событие.БазаДанных());
	КонецЕсли;
	Если НЕ ПустаяСтрока(Событие.ИмяТаблицы()) Тогда
		ДобавитьАтрибут(Атрибуты, ОтелСемантическиеСоглашения.ИмяКоллекцииБД(), Событие.ИмяТаблицы());
	КонецЕсли;
	Если НЕ ПустаяСтрока(Событие.Адрес()) Тогда
		ДобавитьАтрибут(Атрибуты, ОтелСемантическиеСоглашения.АдресСервера(), Событие.Адрес());
		ДобавитьАтрибут(Атрибуты, ОтелСемантическиеСоглашения.ПортСервера(), Событие.Порт());
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьАтрибут(Атрибуты, Знач Ключ, Знач Значение)

	Если ТипЗнч(Атрибуты) = Тип("Соответствие") Тогда
		Атрибуты.Вставить(Ключ, Значение);
	Иначе
		Атрибуты.Установить(Ключ, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ЗавершитьСпан(Знач Событие)

	Состояние = Событие.Состояние();
	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Спан = Состояние.Спан;

	Если Событие.КоличествоСтрок() <> Неопределено Тогда
		Если Событие.Вид() = ВидыСобытийИсточникаДанных.Операция() Тогда
			Спан.УстановитьАтрибут("entity.result.count", Событие.КоличествоСтрок());
		Иначе
			Спан.УстановитьАтрибут(ОтелСемантическиеСоглашения.ВозвращенныеСтрокиБД(), Событие.КоличествоСтрок());
		КонецЕсли;
	КонецЕсли;

	Ошибка = Событие.Ошибка();
	Если Ошибка <> Неопределено Тогда
		Спан.ЗаписатьИсключение(Ошибка);
		Спан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), Ошибка.Описание);
		Спан.УстановитьАтрибут(ОтелСемантическиеСоглашения.ТипОшибки(), ТипОшибки(Ошибка));
	КонецЕсли;

	// Область закрывается до завершения спана, как в остальных инструментированиях.
	ОтелКонтекст.ОтсоединитьКонтекст(Состояние.Токен);
	Спан.Завершить();

КонецПроцедуры

// Тип ошибки для error.type: имя модуля, откуда пришло исключение, как в exception.type
// у ОтелСпан.ЗаписатьИсключение. У исключений OneScript нет иерархии типов.
//
Функция ТипОшибки(Знач Ошибка)

	Попытка
		Если НЕ ПустаяСтрока(Ошибка.ИмяМодуля) Тогда
			Возврат Ошибка.ИмяМодуля;
		КонецЕсли;
	Исключение
		// Свойство недоступно - остается общий тип.
	КонецПопытки;

	Возврат "RuntimeError";

КонецФункции

// Метрики

Функция СоздатьИнструменты(Знач Метр)

	Совет = Новый Структура("ГраницыГистограммы", ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД());
	Соединение = "{connection}";

	Результат = Новый Структура;
	Результат.Вставить("ДлительностьЗапроса", Метр.СоздатьГистограмму(
		ОтелСемантическиеСоглашения.МетрикаДлительностиОперацииБД(), "Длительность запросов к СУБД", "s", Совет));
	Результат.Вставить("ДлительностьОперации", Метр.СоздатьГистограмму(
		"entity.operation.duration", "Длительность операций менеджера сущностей", "s", Совет));
	Результат.Вставить("Сущности", Метр.СоздатьСчетчик(
		"entity.entities", "Сущности, сохраненные, прочитанные и удаленные операциями", "{entity}"));
	Результат.Вставить("Транзакции", Метр.СоздатьСчетчик(
		"entity.transactions", "Завершенные транзакции по исходам", "{transaction}"));
	Результат.Вставить("ОжиданиеСоединения", Метр.СоздатьГистограмму(
		ОтелСемантическиеСоглашения.МетрикаВремениОжиданияСоединенияБД(), "Время получения соединения из пула", "s", Совет));
	Результат.Вставить("СозданиеСоединения", Метр.СоздатьГистограмму(
		ОтелСемантическиеСоглашения.МетрикаВремениСозданияСоединенияБД(), "Время открытия нового соединения", "s", Совет));
	Результат.Вставить("ТаймаутыСоединений", Метр.СоздатьСчетчик(
		ОтелСемантическиеСоглашения.МетрикаТаймаутовСоединенийБД(), "Захваты соединения, завершившиеся ошибкой", "{timeout}"));

	// Состояние пула читается из последнего снимка при сборе метрик: так на события соединений
	// не приходится по несколько записей в инструменты, а значения все равно текущие.
	Результат.Вставить("Соединения", Метр.СоздатьНаблюдаемыйРеверсивныйСчетчик(
		ОтелСемантическиеСоглашения.МетрикаКоличестваСоединенийБД(), Новый Действие(ЭтотОбъект, "НаблюдатьСоединения"),
		"Соединения пула по состояниям", Соединение));
	Результат.Вставить("ПределСоединений", Метр.СоздатьНаблюдаемыйРеверсивныйСчетчик(
		ОтелСемантическиеСоглашения.МетрикаПределаСоединенийБД(), Новый Действие(ЭтотОбъект, "НаблюдатьПределСоединений"),
		"Размер пула соединений", Соединение));
	Результат.Вставить("ОжидающиеЗапросы", Метр.СоздатьНаблюдаемыйРеверсивныйСчетчик(
		ОтелСемантическиеСоглашения.МетрикаОжидающихЗапросовСоединенийБД(), Новый Действие(ЭтотОбъект, "НаблюдатьОжидающиеЗапросы"),
		"Потоки исполнения в очереди за соединением", "{request}"));

	Возврат Результат;

КонецФункции

Процедура ЗаписатьМетрикиОперации(Знач Событие)

	Ключ = "операция|" + Событие.Операция() + "|" + Строка(Событие.ТипСущности());
	Атрибуты = КэшАтрибутов.Получить(Ключ);
	Если Атрибуты = Неопределено Тогда
		Атрибуты = Новый ОтелАтрибуты;
		Атрибуты.Установить("entity.operation", Событие.Операция());
		Если Событие.ТипСущности() <> Неопределено Тогда
			Атрибуты.Установить("entity.type", Строка(Событие.ТипСущности()));
		КонецЕсли;
		КэшАтрибутов.Вставить(Ключ, Атрибуты);
	КонецЕсли;

	Инструменты.ДлительностьОперации.Записать(Секунды(Событие.Длительность()), СОшибкой(Атрибуты, Событие));

	Если Событие.Ошибка() <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	КоличествоСущностей = КоличествоСущностей(Событие);
	Если КоличествоСущностей > 0 Тогда
		Инструменты.Сущности.Добавить(КоличествоСущностей, Атрибуты);
	КонецЕсли;

КонецПроцедуры

// Сущности, прошедшие через операцию: запись и удаление - одна сущность, чтение - строки результата.
//
Функция КоличествоСущностей(Знач Событие)

	Операция = Событие.Операция();
	Если Операция = "Сохранить" ИЛИ Операция = "Удалить" Тогда
		Возврат 1;
	КонецЕсли;
	Если Событие.КоличествоСтрок() <> Неопределено Тогда
		Возврат Событие.КоличествоСтрок();
	КонецЕсли;

	Возврат 0;

КонецФункции

Процедура ЗаписатьМетрикиЗапроса(Знач Событие)

	Ключ = СтрШаблон("запрос|%1|%2|%3|%4|%5", Событие.Система(), Событие.Операция(), Событие.БазаДанных(), Событие.ИмяТаблицы(), Событие.Адрес());
	Атрибуты = КэшАтрибутов.Получить(Ключ);
	Если Атрибуты = Неопределено Тогда
		Атрибуты = Новый ОтелАтрибуты;
		ЗаполнитьАтрибутыБД(Атрибуты, Событие);
		КэшАтрибутов.Вставить(Ключ, Атрибуты);
	КонецЕсли;

	Инструменты.ДлительностьЗапроса.Записать(Секунды(Событие.Длительность()), СОшибкой(Атрибуты, Событие));

КонецПроцедуры

Процедура ЗаписатьМетрикиСоединения(Знач Событие)

	Снимок = СнимокПула(Событие);

	Если Событие.Операция() = "Занять" Тогда
		Если Событие.Ошибка() <> Неопределено Тогда
			Инструменты.ТаймаутыСоединений.Добавить(1, Снимок.АтрибутыПула);
		КонецЕсли;
		Если Событие.Ожидание() <> Неопределено Тогда
			Инструменты.ОжиданиеСоединения.Записать(Секунды(Событие.Ожидание()), Снимок.АтрибутыПула);
		КонецЕсли;
		Если Событие.Открыто() = Истина Тогда
			Инструменты.СозданиеСоединения.Записать(Секунды(Событие.ВремяОткрытия()), Снимок.АтрибутыПула);
		КонецЕсли;
	КонецЕсли;

	Если Событие.Занято() = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Снимок.Занято = Событие.Занято();
	Снимок.Свободно = Событие.Свободно();
	Снимок.Ожидает = Событие.Ожидает();
	Снимок.Предел = Событие.Предел();

КонецПроцедуры

// Снимок пула по имени пула из события; создается при первом событии пула вместе с наборами
// атрибутов, чтобы наблюдаемые счетчики и гистограммы не собирали их заново.
//
Функция СнимокПула(Знач Событие)

	ИмяПула = ИмяПула(Событие);
	Снимок = СнимкиПулов.Получить(ИмяПула);
	Если Снимок <> Неопределено Тогда
		Возврат Снимок;
	КонецЕсли;

	АтрибутыПула = Новый ОтелАтрибуты;
	АтрибутыПула.Установить(ОтелСемантическиеСоглашения.ИмяПулаСоединенийБД(), ИмяПула);

	Снимок = Новый Структура;
	Снимок.Вставить("Занято", 0);
	Снимок.Вставить("Свободно", 0);
	Снимок.Вставить("Ожидает", 0);
	Снимок.Вставить("Предел", 0);
	Снимок.Вставить("АтрибутыПула", АтрибутыПула);
	Снимок.Вставить("АтрибутыЗанято", СоСостоянием(АтрибутыПула, ОтелСемантическиеСоглашения.СостояниеСоединенияИспользуется()));
	Снимок.Вставить("АтрибутыСвободно", СоСостоянием(АтрибутыПула, ОтелСемантическиеСоглашения.СостояниеСоединенияСвободно()));

	// Пулов у наблюдателя обычно один-два; снимки читаются из потока сбора метрик, поэтому
	// соответствие заменяется целиком, а не дописывается.
	НовыеСнимки = Новый Соответствие;
	Для Каждого ИмяИСнимок Из СнимкиПулов Цикл
		НовыеСнимки.Вставить(ИмяИСнимок.Ключ, ИмяИСнимок.Значение);
	КонецЦикла;
	НовыеСнимки.Вставить(ИмяПула, Снимок);
	СнимкиПулов = НовыеСнимки;

	Возврат Снимок;

КонецФункции

Процедура ЗаписатьМетрикиТранзакции(Знач Событие)

	Ключ = "транзакция|" + Событие.Исход();
	Атрибуты = КэшАтрибутов.Получить(Ключ);
	Если Атрибуты = Неопределено Тогда
		Атрибуты = Новый ОтелАтрибуты;
		Атрибуты.Установить("entity.transaction.result", Событие.Исход());
		КэшАтрибутов.Вставить(Ключ, Атрибуты);
	КонецЕсли;

	Инструменты.Транзакции.Добавить(1, Атрибуты);

КонецПроцедуры

// Имя пула для db.client.connection.pool.name: источник данных без секретов.
//
Функция ИмяПула(Знач Событие)

	Если ПустаяСтрока(Событие.Адрес()) Тогда
		Возврат Событие.Система() + ":" + Событие.БазаДанных();
	КонецЕсли;

	Возврат СтрШаблон("%1://%2:%3/%4", Событие.Система(), Событие.Адрес(), Формат(Событие.Порт(), "ЧГ=0"), Событие.БазаДанных());

КонецФункции

Функция СОшибкой(Знач Атрибуты, Знач Событие)

	Если Событие.Ошибка() = Неопределено Тогда
		Возврат Атрибуты;
	КонецЕсли;

	Результат = Новый ОтелАтрибуты;
	Для Каждого КлючИЗначение Из Атрибуты.ВСоответствие() Цикл
		Результат.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Результат.Установить(ОтелСемантическиеСоглашения.ТипОшибки(), ТипОшибки(Событие.Ошибка()));

	Возврат Результат;

КонецФункции

Функция СоСостоянием(Знач АтрибутыПула, Знач Состояние)

	Результат = Новый ОтелАтрибуты;
	Для Каждого КлючИЗначение Из АтрибутыПула.ВСоответствие() Цикл
		Результат.Установить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Результат.Установить(ОтелСемантическиеСоглашения.СостояниеСоединенияБД(), Состояние);

	Возврат Результат;

КонецФункции

Функция Секунды(Знач Миллисекунды)

	Если Миллисекунды = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Миллисекунды / 1000;

КонецФункции

Функция Настройка(Знач Настройки, Знач Имя, Знач ПоУмолчанию)

	Если Настройки = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Значение = Неопределено;
	Если НЕ Настройки.Свойство(Имя, Значение) ИЛИ Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции
