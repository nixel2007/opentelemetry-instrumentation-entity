#Использовать opentelemetry
#Использовать decorator

// ОтелМетр - Метр для гистограммы вызовов.
Перем Метр;
// Рефлектор - Читает методы оборачиваемого объекта.
Перем ЛокальныйРефлектор;
// Соответствие - Методы, которые не ходят в БД и не оборачиваются (в нижнем регистре).
Перем ИсключаемыеМетоды;

// Оборачивает хранилище сущностей в декоратор, который пишет длительность каждого вызова метода
// в гистограмму entity.repository.invocation.duration - аналог spring.data.repository.invocations.
//
// Спанов обертка не создает: вложенность вызова в трейсе дают операции и запросы, которые метод
// выполняет, если на источнике данных зарегистрирован ОтелНаблюдательИсточникаДанных.
//
// Оборачиваются экспортные методы фактического объекта, кроме тех, что не ходят в БД:
// ПолучитьОбъектМодели, ПолучитьПулСущностей, СоздатьЭлемент, Закрыть. Если оборачивать нечего,
// возвращается исходный объект.
//
// Параметры:
//   ХранилищеСущностей     - Произвольный - Типизированное хранилище сущностей entity либо собственное
//   ИмяХранилищаСущностей  - Строка       - Имя в атрибуте entity.repository
//
// Возвращаемое значение:
//   Произвольный - Обертка с перехватчиками либо исходный объект
//
Функция Обернуть(ХранилищеСущностей, Знач ИмяХранилищаСущностей) Экспорт

	Если Метр = Неопределено Тогда
		Возврат ХранилищеСущностей;
	КонецЕсли;

	ИменаМетодов = ИменаОборачиваемыхМетодов(ХранилищеСущностей);
	Если ИменаМетодов.Количество() = 0 Тогда
		Возврат ХранилищеСущностей;
	КонецЕсли;

	Построитель = Новый ПостроительДекоратора(ХранилищеСущностей)
		.Импорт(Новый Импорт("opentelemetry"))
		.Поле(Новый Поле("Декоратор_Метр").ЗначениеПоУмолчанию(Метр));

	// Имя приходит от вызывающего кода и попадает в текст генерируемого декоратора строковым
	// литералом: кавычку в нем надо удвоить, иначе литерал развалится.
	ИмяВЛитерале = СтрЗаменить(ИмяХранилищаСущностей, """", """""");

	Для Каждого ИмяМетода Из ИменаМетодов Цикл
		ДобавитьПерехватчики(Построитель, ИмяВЛитерале, ИмяМетода);
	КонецЦикла;

	Возврат Построитель.Построить();

КонецФункции

// Методы берутся с самого объекта, а не из его определения: у собственного хранилища сущностей
// в определении нет унаследованных от ХранилищеСущностей методов, а у типизированного
// хранилища entity - нет ни одного.
//
// Параметры:
//   ХранилищеСущностей - Произвольный - Оборачиваемый объект
//
// Возвращаемое значение:
//   Массив из Строка - Имена методов, вокруг которых ставятся перехватчики
//
Функция ИменаОборачиваемыхМетодов(ХранилищеСущностей)

	Результат = Новый Массив;

	Для Каждого Метод Из ЛокальныйРефлектор.ПолучитьТаблицуМетодов(ХранилищеСущностей) Цикл

		Если НЕ Метод.Экспорт Тогда
			Продолжить;
		КонецЕсли;

		ИмяВНижнемРегистре = НРег(Метод.Имя);
		ЭтоСлужебныйМетодДекоратора = СтрНачинаетсяС(ИмяВНижнемРегистре, "декоратор_");
		Если ИсключаемыеМетоды.Получить(ИмяВНижнемРегистре) <> Неопределено ИЛИ ЭтоСлужебныйМетодДекоратора Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Метод.Имя);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьПерехватчики(Построитель, Знач ИмяХранилищаСущностей, Знач ИмяМетода)

	АтрибутыМетрики = "Декоратор_Атрибуты = Новый ОтелАтрибуты();
		|Декоратор_Атрибуты.Установить(""entity.repository"", """ + ИмяХранилищаСущностей + """);
		|Декоратор_Атрибуты.Установить(""code.function.name"", """ + ИмяМетода + """);
		|";

	ТелоПеред = "Декоратор_ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();";

	ТелоПосле = АтрибутыМетрики
		+ "Декоратор_Атрибуты.Установить(""entity.repository.state"", ""success"");
		|" + ЗаписьГистограммы();

	ТелоИсключения = "Декоратор_ТипОшибки = ИнформацияОбОшибке().ИмяМодуля;
		|Если ПустаяСтрока(Декоратор_ТипОшибки) Тогда
		|	Декоратор_ТипОшибки = ""RuntimeError"";
		|КонецЕсли;
		|" + АтрибутыМетрики
		+ "Декоратор_Атрибуты.Установить(""entity.repository.state"", ""error"");
		|Декоратор_Атрибуты.Установить(""error.type"", Декоратор_ТипОшибки);
		|" + ЗаписьГистограммы();

	ПередВызовом = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
		.Тело(ТелоПеред);

	ПослеВызова = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.После)
		.Тело(ТелоПосле);

	ПослеИсключения = Новый Перехватчик(ИмяМетода)
		.ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения)
		.Тело(ТелоИсключения);

	Построитель
		.Перехватчик(ПередВызовом)
		.Перехватчик(ПослеВызова)
		.Перехватчик(ПослеИсключения);

КонецПроцедуры

// Текст записи длительности вызова в гистограмму entity.repository.invocation.duration, в секундах,
// с границами бакетов из семантических соглашений для клиентов баз данных.
//
// Возвращаемое значение:
//   Строка - Фрагмент тела перехватчика
//
Функция ЗаписьГистограммы()

	ОписаниеГистограммы = "Длительность вызовов методов хранилищ сущностей";

	Возврат "Декоратор_Совет = Новый Структура(
		|	""ГраницыГистограммы"", ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД());
		|Декоратор_Гистограмма = Декоратор_Метр.СоздатьГистограмму(
		|	""entity.repository.invocation.duration"", """ + ОписаниеГистограммы + """, ""s"", Декоратор_Совет);
		|Декоратор_Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Декоратор_ВремяНачала;
		|Декоратор_Гистограмма.Записать(Декоратор_Длительность / 1000, Декоратор_Атрибуты);";

КонецФункции

// Инструментирование слоя хранилищ сущностей.
//
// Параметры:
//   ОтелМетр - ОтелМетр - Метр для гистограммы вызовов. Неопределено выключает инструментирование:
//                         Обернуть возвращает исходный объект
//
Процедура ПриСозданииОбъекта(ОтелМетр)

	Метр = ОтелМетр;
	ЛокальныйРефлектор = Новый Рефлектор();

	// Методы, которые не ходят в базу данных, оборачивать незачем.
	МетодыБезОбращенияКБД = "ПриСозданииОбъекта,ПолучитьОбъектМодели,ПолучитьПулСущностей,СоздатьЭлемент,Закрыть";

	ИсключаемыеМетоды = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(МетодыБезОбращенияКБД, ",") Цикл
		ИсключаемыеМетоды.Вставить(НРег(Имя), Истина);
	КонецЦикла;

КонецПроцедуры
