#Использовать opentelemetry
#Использовать decorator
#Использовать reflector

// ОтелТрассировщик - Трассировщик для спанов вызовов методов хранилища сущностей.
Перем Трассировщик;
// ОтелМетр - Метр для гистограммы вызовов.
Перем Метр;
// Рефлектор - Читает методы оборачиваемого объекта.
Перем ЛокальныйРефлектор;
// Соответствие - Методы, которые не ходят в БД и не оборачиваются (в нижнем регистре).
Перем ИсключаемыеМетоды;

// Оборачивает хранилище сущностей в декоратор, который на каждый вызов метода создает спан
// "ИмяХранилищаСущностей.ИмяМетода" с атрибутами code.* и пишет длительность вызова в гистограмму
// entity.repository.invocations - аналог spring.data.repository.invocations. Операции и запросы,
// которые метод выполняет, становятся дочерними спанами благодаря ОтелНаблюдательИсточникаДанных.
//
// Оборачиваются экспортные методы фактического объекта, кроме тех, что не ходят в БД:
// ПолучитьОбъектМодели, ПолучитьПулСущностей, СоздатьЭлемент, Закрыть. Если оборачивать нечего,
// возвращается исходный объект.
//
// Параметры:
//   ХранилищеСущностей     - Произвольный - Типизированное хранилище сущностей entity либо собственное
//   ИмяХранилищаСущностей  - Строка       - Имя в спанах и атрибуте entity.repository
//
// Возвращаемое значение:
//   Произвольный - Обертка с перехватчиками либо исходный объект
//
Функция Обернуть(ХранилищеСущностей, Знач ИмяХранилищаСущностей) Экспорт

	ИменаМетодов = ИменаОборачиваемыхМетодов(ХранилищеСущностей);
	Если ИменаМетодов.Количество() = 0 Тогда
		Возврат ХранилищеСущностей;
	КонецЕсли;

	Построитель = Новый ПостроительДекоратора(ХранилищеСущностей)
		.Импорт(Новый Импорт("opentelemetry"))
		.Поле(Новый Поле("Декоратор_Трассировщик").ЗначениеПоУмолчанию(Трассировщик))
		.Поле(Новый Поле("Декоратор_Метр").ЗначениеПоУмолчанию(Метр));

	Для Каждого ИмяМетода Из ИменаМетодов Цикл
		ДобавитьПерехватчики(Построитель, ИмяХранилищаСущностей, ИмяМетода);
	КонецЦикла;

	Возврат Построитель.Построить();

КонецФункции

// Методы берутся с самого объекта, а не из его определения: у собственного хранилища сущностей
// в определении нет унаследованных от ХранилищеСущностей методов, а у типизированного
// хранилища entity - нет ни одного.
//
Функция ИменаОборачиваемыхМетодов(ХранилищеСущностей)

	Результат = Новый Массив;

	Для Каждого Метод Из ЛокальныйРефлектор.ПолучитьТаблицуМетодов(ХранилищеСущностей) Цикл
		Если НЕ Метод.Экспорт Тогда
			Продолжить;
		КонецЕсли;
		ИмяВНижнемРегистре = НРег(Метод.Имя);
		Если ИсключаемыеМетоды.Получить(ИмяВНижнемРегистре) <> Неопределено ИЛИ Лев(ИмяВНижнемРегистре, 10) = "декоратор_" Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Метод.Имя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьПерехватчики(Построитель, Знач ИмяХранилищаСущностей, Знач ИмяМетода)

	ТелоПеред = "Декоратор_ЛокальныйСпан = Декоратор_Трассировщик.НачатьСпан(""" + ИмяХранилищаСущностей + "." + ИмяМетода + """);
		|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""code.function.name"", """ + ИмяМетода + """);
		|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""code.namespace"", """ + ИмяХранилищаСущностей + """);
		|Декоратор_ОбластьСпана = Декоратор_ЛокальныйСпан.СделатьТекущим();
		|Декоратор_ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();";

	ТелоПосле = "Декоратор_ОбластьСпана.Закрыть();
		|Декоратор_ЛокальныйСпан.Завершить();
		|Декоратор_Атрибуты = Новый ОтелАтрибуты();
		|Декоратор_Атрибуты.Установить(""entity.repository"", """ + ИмяХранилищаСущностей + """);
		|Декоратор_Атрибуты.Установить(""code.function.name"", """ + ИмяМетода + """);
		|Декоратор_Атрибуты.Установить(""entity.repository.state"", ""success"");
		|" + ЗаписьГистограммы();

	ТелоИсключения = "Декоратор_ТипОшибки = ИнформацияОбОшибке().ИмяМодуля;
		|Если ПустаяСтрока(Декоратор_ТипОшибки) Тогда
		|	Декоратор_ТипОшибки = ""RuntimeError"";
		|КонецЕсли;
		|Декоратор_ЛокальныйСпан.ЗаписатьИсключение(ИнформацияОбОшибке());
		|Декоратор_ЛокальныйСпан.УстановитьСтатус(ОтелКодСтатуса.Ошибка(), ОписаниеОшибки());
		|Декоратор_ЛокальныйСпан.УстановитьАтрибут(""error.type"", Декоратор_ТипОшибки);
		|Декоратор_ОбластьСпана.Закрыть();
		|Декоратор_ЛокальныйСпан.Завершить();
		|Декоратор_Атрибуты = Новый ОтелАтрибуты();
		|Декоратор_Атрибуты.Установить(""entity.repository"", """ + ИмяХранилищаСущностей + """);
		|Декоратор_Атрибуты.Установить(""code.function.name"", """ + ИмяМетода + """);
		|Декоратор_Атрибуты.Установить(""entity.repository.state"", ""error"");
		|Декоратор_Атрибуты.Установить(""error.type"", Декоратор_ТипОшибки);
		|" + ЗаписьГистограммы();

	Построитель
		.Перехватчик(Новый Перехватчик(ИмяМетода).ТипПерехватчика(ТипыПерехватчиковМетода.Перед).Тело(ТелоПеред))
		.Перехватчик(Новый Перехватчик(ИмяМетода).ТипПерехватчика(ТипыПерехватчиковМетода.После).Тело(ТелоПосле))
		.Перехватчик(Новый Перехватчик(ИмяМетода).ТипПерехватчика(ТипыПерехватчиковМетода.ПослеВызоваИсключения).Тело(ТелоИсключения));

КонецПроцедуры

// Текст записи длительности вызова в гистограмму entity.repository.invocations, в секундах,
// с границами бакетов из семантических соглашений для клиентов баз данных.
//
Функция ЗаписьГистограммы()

	Возврат "Декоратор_Совет = Новый Структура(""ГраницыГистограммы"", ОтелСемантическиеСоглашения.ГраницыДлительностиОперацииБД());
		|Декоратор_Метр.СоздатьГистограмму(""entity.repository.invocations"", ""Длительность вызовов методов хранилищ сущностей"", ""s"", Декоратор_Совет)
		|	.Записать((ТекущаяУниверсальнаяДатаВМиллисекундах() - Декоратор_ВремяНачала) / 1000, Декоратор_Атрибуты);";

КонецФункции

// Инструментирование слоя хранилищ сущностей.
//
// Параметры:
//   ОтелТрассировщик - ОтелТрассировщик - Трассировщик для спанов вызовов
//   ОтелМетр         - ОтелМетр         - Метр для гистограммы вызовов
//
Процедура ПриСозданииОбъекта(ОтелТрассировщик, ОтелМетр)

	Трассировщик = ОтелТрассировщик;
	Метр = ОтелМетр;
	ЛокальныйРефлектор = Новый Рефлектор();

	ИсключаемыеМетоды = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить("присозданииобъекта,получитьобъектмодели,получитьпулсущностей,создатьэлемент,закрыть", ",") Цикл
		ИсключаемыеМетоды.Вставить(Имя, Истина);
	КонецЦикла;

КонецПроцедуры
